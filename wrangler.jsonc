// Un solo Worker: sirve la app (dist/, generado por `npm run build`) y la API en /api/*
// (revisión de fotos con IA). El resto del backend es Supabase (proyecto "chelas"): base de
// datos, fotos y tiempo real; ver supabase/migrations.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "millon-de-chelas",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  // chela.happytohelp.mx es el principal; chelas.happytohelp.mx (la primera liga) redirige a él.
  "routes": [
    { "pattern": "chela.happytohelp.mx", "custom_domain": true },
    { "pattern": "chelas.happytohelp.mx", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Todo pasa por el Worker (redirige la liga vieja y luego sirve los estáticos con ASSETS).
    "run_worker_first": true
  },
  // POST /api/revisar por IP (alto por el CGNAT de los celulares). Cada foto se revisa a lo
  // más 3 veces de todos modos (ia_tomar en la base).
  "ratelimits": [{ "name": "REVISAR_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }],
  // Cada minuto: revisa lo que quedó pendiente (el cliente cerró la app o la IA falló).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://ymujpzomslehtsbjwugm.supabase.co",
    "SUPABASE_KEY": "sb_publishable_-Rbwmhvfe53m0aW5hJmZiw_wCVtBIMu",
    "SITE_URL": "https://chela.happytohelp.mx",
    // Orígenes que pueden llamar /api/revisar, separados por comas. Vacío = cualquiera
    // (`npm run dev:api` lo vacía).
    "ALLOWED_ORIGINS": "https://chela.happytohelp.mx",
    // Modelo con visión en OpenRouter. Más barato: "anthropic/claude-haiku-5.5".
    "OPENROUTER_MODEL": "anthropic/claude-sonnet-5.5",
    "JEV_MODEL": "jev-1.13.0",
    // Llave pública VAPID de los avisos push (la privada es el secret VAPID_PRIVATE_JWK). La
    // misma va en .env como VITE_VAPID_PUBLIC.
    "VAPID_PUBLIC": "BPpEdKiWFV2upB9_TohvnZTWdttsONnF94Ll55yr_lMIVtI1-kqo9TEERPR7ETzpZAVaipJsygco5MnVtNQ6fo4",
    // Probabilidad (Jev) de que sea cerveza: ≥ APROBAR se aprueba sola, ≤ RECHAZAR se rechaza
    // sola; en medio la revisa un admin en /admin. Calibrado con fotos reales (11/10/2026):
    // no-cerveza 0.03-0.06 (café, refresco, dibujo, Heineken 0.0), cervezas 0.93-0.98, una
    // michelada sin lata a la vista 0.68.
    "JEV_APROBAR": "0.65",
    "JEV_RECHAZAR": "0.2"
  },
  // Secrets (wrangler secret put …; en local, .dev.vars): OPENROUTER_API_KEY, TYPESAFE_API_KEY,
  // SERVER_KEY (= private.ajustes.clave_servidor en la base), VAPID_PRIVATE_JWK y SUPABASE_SECRET
  // (service_role de Supabase, JWT; solo para borrar los archivos de lo que la IA rechaza).
  "observability": { "enabled": true }
}
